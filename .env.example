APP_NAME="Mukuba Motors API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Lusaka
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database — XAMPP MySQL ─────────────────────────────
# These match XAMPP default settings on Windows
# Create a database called "mukuba_motors" in phpMyAdmin first
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mukuba_motors
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@mukubamotors.zm"
MAIL_FROM_NAME="${APP_NAME}"

# ── CORS ───────────────────────────────────────────────
# The URL your React frontend runs on locally
FRONTEND_URL=http://localhost:5173

# ── Super Admin ────────────────────────────────────────
# Change these before going live
SUPER_ADMIN_EMAIL=superadmin@platform.dev
SUPER_ADMIN_PASSWORD=Platform$uper2025!
